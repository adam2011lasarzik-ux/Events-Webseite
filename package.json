    "react-dom": "19.2.0",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "5.7.2"
  },
