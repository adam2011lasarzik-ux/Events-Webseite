/node_modules/.prisma/client

# Von Prisma erzeugter Code (entsteht beim Bauen neu)
/generated/

# Von `prisma init` eingespielte Werkzeug-Dokumentation (ca. 500 KB, dreifach
# abgelegt, u. a. fuer fremde Editoren). Nuetzlich beim Entwickeln, gehoert
# aber nicht ins Projekt-Repository. Bei Bedarf mit `npx prisma init` wieder da.
/.agents/
/.windsurf/
/skills-lock.json
/.claude/skills/prisma-*

# Im Adminbereich hochgeladene Titelbilder. Gehören nicht ins
# Repository: Sie entstehen im Betrieb und wären bei jedem Deployment
# ein Konflikt. Beim Hoster zeigt BILDER_VERZEICHNIS auf einen Ordner,
# den ein Deployment nicht überschreibt.
/daten/

# Bildschirmfotos und Messdaten der Prüfungen. Entstehen bei jedem
# Lauf neu und gehören nicht ins Repository.
/pruefung/.ausgabe/
