// ─────────────────────────────────────────────────────────────────
//  VERA — Datenmodell
//
//  Drei Ebenen, wie im Skill event-backend-database festgelegt:
//
//    Event         die Veranstaltung
//    Registration  EINE Anmeldung (Buchung) einer anmeldenden Person
//    Participant   EINE teilnehmende Person, gehört zu einer Anmeldung
//
//  Der häufigste Denkfehler wäre, eine Anmeldung mit einer Person
//  gleichzusetzen. Eine Familienbuchung mit 2 Erwachsenen und 4
//  Schülern ist EINE Anmeldung mit SECHS Teilnehmern — und belegt
//  sechs Plätze, nicht einen.
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ── Veranstaltung ────────────────────────────────────────────────

enum EventKategorie {
  SPORT
  BUSINESS
  NETWORKING
  SCHULE
  COMMUNITY
  WORKSHOP
  FREIZEIT
  SONSTIGES
}

/// Redaktioneller Zustand — eine bewusste Entscheidung des Veranstalters.
/// NICHT zu verwechseln mit „läuft noch / ist vorbei": Ob ein Event in der
/// Zukunft liegt, gerade läuft oder vorbei ist, ergibt sich aus startAt und
/// endAt und wird deshalb berechnet, nicht gespeichert. Zwei Quellen für
/// dieselbe Wahrheit laufen sonst auseinander.
enum EventStatus {
  ENTWURF
  VEROEFFENTLICHT
  ARCHIVIERT
}

/// Das Aussehen der Event-Seite.
///
/// Nur die Darstellung ändert sich — Daten, Preise, Plätze und die
/// Anmeldung bleiben in jedem Theme identisch. Der Standardwert sorgt
/// dafür, dass bereits vorhandene Veranstaltungen ohne Zutun weiter
/// aussehen wie bisher.
///
/// Ein weiteres Theme braucht künftig genau drei Schritte: ein Wert
/// hier, ein Eintrag in lib/themes.ts, ein Block in styles/themes.css.
enum EventTheme {
  STANDARD
  BUSINESS
  PREMIUM
}

model Event {
  id        String         @id @default(cuid())
  /// Teil der Adresse, z. B. /events/padel-falkensee
  slug      String         @unique
  status    EventStatus    @default(ENTWURF)
  kategorie EventKategorie @default(SONSTIGES)
  theme     EventTheme     @default(STANDARD)

  // Texte
  titel           String
  untertitel      String?
  /// Kurzfassung für die Karte auf der Startseite
  karteTitel      String
  karteKurz       String  @db.Text
  karteZielgruppe String?
  /// Kurztext auf der Event-Seite selbst (nicht zu verwechseln mit
  /// karteKurz, das auf der Startseiten-Karte steht)
  kurz            String  @db.Text
  beschreibung    String  @db.Text
  /// Freies Feld für alles, was nur dieses eine Event betrifft
  hinweise        String? @db.Text

  // Kopfbereich der Event-Seite. Stand früher im globalen Wörterbuch —
  // dort hätte jedes Event dieselbe Überschrift bekommen („Nie
  // gespielt?" über einem Unternehmer-Netzwerkabend). Leer bedeutet:
  // titel bzw. kurz werden verwendet, bestehende Events brechen also
  // nicht.
  heroAugenbraue String?
  heroTitel      String?
  heroText       String? @db.Text

  // Abschluss-Aufruf am Seitenende. Ebenfalls je Event: „Bereit für
  // den ersten Ballwechsel?" unter einem Unternehmer-Netzwerkabend
  // wäre unfreiwillig komisch. Leer = der neutrale Text aus dem
  // Wörterbuch.
  ctaTitel String?
  ctaText  String? @db.Text

  // Zeit — null bedeutet „steht noch nicht fest" und wird auf der
  // Seite als sichtbarer Platzhalter angezeigt.
  startAt DateTime?
  endAt   DateTime?

  // Ort
  ortName String?
  strasse String?
  plz     String?
  stadt   String

  /// Die vollständige Firmierung der Veranstaltungsstätte, also die
  /// rechtliche Gesellschaft — nicht der Anzeigename aus `ortName`.
  ///
  /// Gebraucht wird sie, weil die Veranstaltungsstätte Empfängerin der
  /// Übersichtsaufnahmen ist und als solche benannt werden muss
  /// (Art. 13 Abs. 1 Buchst. e DS-GVO). Sie steht hier am Event und
  /// nicht in einem Text, weil jede Veranstaltung an einem anderen
  /// Ort stattfinden kann — ein fest eingetragener Firmenname wäre
  /// beim zweiten Veranstaltungsort stillschweigend falsch.
  ortFirma String?

  /// Registergericht und Registernummer der Veranstaltungsstätte,
  /// etwa „Amtsgericht Potsdam, HRB 42437". Optional: Nicht jede
  /// Veranstaltungsstätte ist im Handelsregister eingetragen.
  ortRegister String?

  // Medien. Bewusst je Event: eine globale Variable würde jedem
  // zweiten Event dasselbe Video verpassen.
  bildUrl  String?
  videoUrl String?

  /// Zeigt diese Eventseite den Gründerbereich?
  ///
  /// Standardmäßig aus: Bestehende Veranstaltungen sehen damit
  /// unverändert aus, bis der Haken bewusst gesetzt wird. Foto, Name
  /// und Text selbst stehen NICHT hier, sondern einmalig in
  /// Einstellungen — sie gehören zu VERA, nicht zu einem Event.
  gruenderZeigen Boolean @default(false)

  // Plätze. maxPersonen zählt PERSONEN, nicht Anmeldungen.
  // null = unbegrenzt.
  maxPersonen          Int?
  /// Ab wie wenigen freien Plätzen die genaue Zahl angezeigt wird
  schwelleWenigPlaetze Int  @default(10)

  // Preise, immer in ganzen Cent. Kommazahlen rechnen bei Geld
  // ungenau (0.1 + 0.2 ist nicht exakt 0.3).
  //
  // schuelerAktiv steuert, ob dieses Event überhaupt eine eigene
  // Schüler-Preiskategorie hat. Standard "an", damit bestehende Events
  // unverändert bleiben. Ist sie aus, gibt es nur EINEN Preis
  // (preisErwachsenerCents) — kein "Mein Kind", kein Familienpaket,
  // keine Erziehungsberechtigten-Einwilligung. preisSchuelerCents ist
  // deshalb nullable: Ohne Schüler-Kategorie gibt es schlicht keinen
  // Schüler-Preis.
  schuelerAktiv         Boolean @default(true)
  preisSchuelerCents    Int?
  preisErwachsenerCents Int

  // Familienpaket
  familieAktiv                 Boolean @default(false)
  familieBasisCents            Int?
  familieEnthaltenErwachsene   Int?
  familieEnthaltenSchueler     Int?
  familieWeitererSchuelerCents Int?
  familieMaxSchueler           Int?

  // Anmeldezeitraum (optional)
  anmeldungAb  DateTime?
  anmeldungBis DateTime?

  // ── Aufnahmen: endgültig offline (K8) ─────────────────────────
  //
  // Von Hand gesetzt, NICHT vom automatischen Löschlauf: Alle Foto-
  // und Videoaufnahmen dieser Veranstaltung sind von keiner Website,
  // keinem Instagram-Kanal und keiner Weitergabe mehr erreichbar.
  // Erst ab diesem Zeitpunkt beginnt die dreijährige Nachlauffrist
  // für Aufnahmewiderspruch und Veröffentlichungsprüfung zu laufen —
  // siehe faelligAufnahmewiderspruch() in lib/loeschfristen.ts.
  // Diese Entscheidung fällt im Rahmen der jährlichen
  // Erforderlichkeitsprüfung der Aufnahmen (Entscheidung 4.6), aber
  // ausdrücklich nicht automatisch durch sie.
  aufnahmenOfflineAm    DateTime?
  /// Wer die Entscheidung getroffen hat (AdminUser-Kennung).
  aufnahmenOfflineVon   String?
  /// Was geprüft wurde, z. B. "Website und Instagram-Beitrag entfernt,
  /// Weitergabe an die Halle widerrufen".
  aufnahmenOfflineNotiz String?   @db.Text

  erstelltAm  DateTime @default(now())
  geaendertAm DateTime @updatedAt

  anmeldungen                  Registration[]
  abschnitte                   EventAbschnitt[]
  aufnahmewidersprueche        Aufnahmewiderspruch[]
  veroeffentlichungspruefungen Veroeffentlichungspruefung[]
  veroeffentlichungen          Veroeffentlichung[]

  @@index([status, startAt])
}

/// Optionale Inhaltsblöcke je Event — Programm, Speaker, Sponsoren,
/// Anfahrt und was künftige Event-Arten sonst brauchen.
///
/// Eigene Tabelle statt eines JSON-Feldes: So bleibt die Struktur
/// prüfbar und sortierbar, und ein Workshop kann andere Blöcke haben
/// als ein Sportevent, ohne dass die Event-Tabelle wächst.
/// (Angelegt, aber noch nicht auf der Webseite angezeigt.)
model EventAbschnitt {
  id          String @id @default(cuid())
  eventId     String
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// z. B. "programm", "speaker", "sponsoren", "anfahrt"
  art         String
  titel       String
  inhalt      String @db.Text
  reihenfolge Int    @default(0)

  @@index([eventId, reihenfolge])
}

// ── Anmeldung (Buchung) ──────────────────────────────────────────

enum Buchungsart {
  EINZEL
  FAMILIE
}

/// Der Zustand einer Anmeldung.
///
/// `RESERVIERT` ist am 26.09.2026 ersatzlos entfallen. Seitdem
/// entsteht eine Anmeldung erst mit der bestätigten Zahlung — eine
/// unbezahlte gibt es nicht mehr, also auch keinen Zustand dafür.
/// Vorhandene Zeilen hat die Migration auf `STORNIERT` gesetzt; sie
/// waren allesamt abgebrochene Bezahlvorgänge.
enum AnmeldeStatus {
  BESTAETIGT
  WARTELISTE
  STORNIERT
}

enum ZahlungsStatus {
  OFFEN
  BEZAHLT
  ERSTATTET
  TEILWEISE_ERSTATTET
}

enum ZahlungsWeg {
  VOR_ORT
  UEBERWEISUNG
  ONLINE
}

model Registration {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Anmeldende Person (nicht zwingend selbst Teilnehmer — ein
  // Elternteil kann nur das Kind anmelden und bleibt trotzdem
  // Vertragspartner).
  kontaktVorname  String
  kontaktNachname String
  kontaktEmail    String
  kontaktTelefon  String?

  buchungsart Buchungsart   @default(EINZEL)
  status      AnmeldeStatus @default(BESTAETIGT)

  // Minderjährige: Einwilligung der Erziehungsberechtigten ist
  // Pflicht, sobald Minderjährige dabei sind. Die Foto-Einwilligung
  // ist davon getrennt und freiwillig — eine Anmeldung darf nicht
  // daran scheitern, dass jemand keine Fotos möchte.
  istVormundBuchung   Boolean @default(false)
  einwilligungVormund Boolean @default(false)

  /**
   * ── Zwei Pflichtangaben, die keine Einwilligungen sind ──────────
   * `agbAkzeptiert` ist die Annahme der Teilnahmebedingungen. Ohne
   * sie werden sie nach § 305 Abs. 2 BGB nicht Vertragsbestandteil —
   * dann gälte für Storno, Haftung und alles Übrige das Gesetz, und
   * die ausformulierten Bedingungen wären wirkungslos.
   * `kenntnisAufnahmen` ist die Kenntnisnahme, dass bei der
   * Veranstaltung Übersichtsaufnahmen entstehen. Sie ist ausdrücklich
   * KEINE Einwilligung nach Art. 6 Abs. 1 Buchst. a DS-GVO — genau
   * deshalb darf sie Pflicht sein (Art. 7 Abs. 4 DS-GVO: Eine
   * Einwilligung, ohne die der Vertrag nicht zustande kommt, wäre
   * nicht freiwillig und damit unwirksam). Die Aufnahmen selbst
   * stützen sich auf Art. 6 Abs. 1 Buchst. f DS-GVO; wer nicht
   * abgebildet werden möchte, widerspricht nach Art. 21 DS-GVO.
   * Das frühere Feld `einwilligungFotos` ist mit Entscheidung 4.8
   * entfallen: Es gibt keine Foto-Einwilligung mehr, die es festhalten
   * könnte (Bauaufträge B-10 und B-17).
   */
  agbAkzeptiert     Boolean @default(false)
  kenntnisAufnahmen Boolean @default(false)

  /// Zum Zeitpunkt der Anmeldung eingefroren. Ändert der Veranstalter
  /// später den Eventpreis, darf sich der Betrag einer bereits
  /// erfolgten Anmeldung nicht rückwirkend verändern.
  gesamtpreisCents Int

  // Zahlungsstatus wird GETRENNT vom Anmeldestatus geführt:
  // jemand kann angemeldet, aber noch nicht bezahlt haben.
  zahlungsStatus   ZahlungsStatus @default(OFFEN)
  zahlungsWeg      ZahlungsWeg    @default(ONLINE)
  /// Referenz des Zahlungsanbieters, für den Abgleich.
  /// Das ist die BEZAHLSEITE (Checkout-Sitzung, "cs_…"), nicht die
  /// Zahlung selbst.
  ///
  /// **Eindeutig seit dem 25.09.2026.** Ab dem Umbau entsteht eine
  /// Anmeldung erst mit der bestätigten Zahlung, und drei Wege dürfen
  /// sie anlegen: die Rückmeldung des Anbieters, die Rückfrage auf der
  /// Abschluss-Seite und der nächtliche Abgleich. Damit dieselbe
  /// Zahlung nicht zweimal zu einer Anmeldung wird, entscheidet die
  /// DATENBANK und nicht eine Prüfung im Code: Der zweite Versuch
  /// scheitert am Index. Eine Prüfung im Code liesse sich vergessen
  /// oder überholen, ein eindeutiger Index nicht.
  ///
  /// Mehrere leere Werte bleiben erlaubt — MySQL zählt NULL nicht als
  /// Dubletten. Anmeldungen ohne Bezahlseite (kostenlose
  /// Veranstaltungen, Erfassung von Hand) stören also nicht.
  zahlungsReferenz String? @unique

  /// Die eigentliche Zahlung hinter der Bezahlseite ("pi_…").
  ///
  /// Zwei Dinge hängen daran, die mit der Sitzungskennung allein NICHT
  /// gehen:
  ///   1. Eine Erstattung auslösen — der Anbieter erstattet eine
  ///      Zahlung, keine Bezahlseite.
  ///   2. Eine Erstattungs-Rückmeldung der richtigen Buchung zuordnen.
  ///      Die Meldung trägt Zahlungs- und Charge-Kennung, aber nicht
  ///      die Sitzung. Ohne dieses Feld lief eine im Dashboard von
  ///      Hand ausgelöste Kulanz-Erstattung ins Leere: Die Buchung
  ///      blieb still auf "bezahlt" stehen.
  ///
  /// Optional, weil sie erst mit der Zahlung bekannt wird.
  zahlungsAbsicht      String?
  bezahlterBetragCents Int?
  bezahltAm            DateTime?

  /// Schlüssel für die Selbstbedienungs-Stornierung.
  ///
  /// Bewusst NICHT die Anmeldenummer: Die steht in der Adresse der
  /// Abschluss-Seite und ist laut §8 des Skills ausdrücklich "kein
  /// Zugriffsschutz". Wer eine fremde Buchung stornieren könnte,
  /// löste damit eine echte Geldbewegung aus — dafür reicht eine
  /// unratbare Adresse nicht.
  ///
  /// Dieser Schlüssel steht ausschließlich im Storno-Link der
  /// Bestätigungsmail. Optional, weil bereits bestehende Buchungen
  /// keinen haben (additive Migration nach §9); neue bekommen ihn
  /// beim Anlegen.
  stornoSchluessel String? @unique

  /**
   * ── Welche Fassung der Rechtstexte galt bei dieser Buchung ──────
   * Maßgeblich ist immer die Fassung, die bei VERTRAGSSCHLUSS
   * einbezogen wurde. Ändert VERA die Bedingungen später, gilt für
   * Altbuchungen weiterhin die alte — ohne diese Kennungen liesse
   * sich zwei Jahre später nicht mehr belegen, welche das war.
   * Hier steht bewusst nur die KENNUNG, nicht der Text. Der Wortlaut
   * liegt einmal je Fassung in `Rechtstext`; läge er je Buchung dort,
   * wüchse die Datenbank mit jedem Ticket um mehrere Kilobyte, und das
   * Löschkonzept müsste denselben Text tausendfach mitbehandeln.
   * Optional, weil Buchungen von vor dieser Änderung keine haben
   * (additive Migration nach §9 des Skills).
   */
  agbFassungId         String?
  agbFassung           Rechtstext? @relation("AgbFassung", fields: [agbFassungId], references: [id])
  datenschutzFassungId String?
  datenschutzFassung   Rechtstext? @relation("DatenschutzFassung", fields: [datenschutzFassungId], references: [id])

  angemeldetAm  DateTime  @default(now())
  reaktiviertAm DateTime?
  storniertAm   DateTime?

  /// Gesetzt, wenn die Personendaten auf Wunsch gelöscht wurden.
  /// Eine Stornierung ist KEINE Löschung: sie muss gespeichert
  /// bleiben, damit Platzzählung und Zahlungsabgleich stimmen. Für das
  /// echte Löschrecht werden Namen, E-Mail und Telefon überschrieben —
  /// die Anmeldung selbst bleibt als anonyme Zeile bestehen.
  anonymisiertAm DateTime?

  /**
   * ── Löschkonzept ────────────────────────────────────────────────
   * Klasse und Fälligkeit stehen am Datensatz selbst, damit der
   * nächtliche Lauf keine Regeln raten muss. `faelligAm` wird bei
   * jedem Lauf aus dem Veranstaltungsdatum neu berechnet — ändert
   * sich der Termin, wandert die Fälligkeit mit.
   */
  loeschklasse Loeschklasse @default(ANMELDEDATEN)
  faelligAm    DateTime?

  teilnehmer            Participant[]
  aufnahmewidersprueche Aufnahmewiderspruch[]

  /// Duplikatsschutz auf Anmeldungs-Ebene: pro Event und E-Mail-Adresse
  /// gibt es genau EINE Anmeldung — auch über Stornierungen hinweg.
  ///
  /// MySQL kennt keine Teil-Indizes wie PostgreSQL, man kann also nicht
  /// „nur aktive Anmeldungen müssen eindeutig sein" erzwingen. Deshalb
  /// der einfachere und robustere Weg: Meldet sich jemand nach einer
  /// Stornierung erneut an, wird derselbe Datensatz reaktiviert statt
  /// ein zweiter angelegt. Damit ist die Bedingung immer erfüllt und es
  /// bleiben keine verwaisten Doppel-Einträge zurück.
  @@unique([eventId, kontaktEmail])
  @@index([eventId, status])
}

// ── Teilnehmende Person ──────────────────────────────────────────

enum TeilnehmerTyp {
  SCHUELER
  ERWACHSENER
}

model Participant {
  id             String       @id @default(cuid())
  registrationId String
  anmeldung      Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  vorname  String
  nachname String
  typ      TeilnehmerTyp

  /// Nur das Jahr, nicht das volle Geburtsdatum — bei Minderjährigen
  /// so sparsam wie möglich mit Daten umgehen.
  geburtsjahr Int?

  @@index([registrationId])
}

// ── Verwaltung ───────────────────────────────────────────────────

/// Zugang zum geschützten Adminbereich. Als Tabelle angelegt statt als
/// Passwort in einer Umgebungsvariable, damit später ein zweiter
/// Administrator dazukommen kann, ohne das Modell zu ändern.
/// (Angelegt, die Anmeldung selbst wird in einem späteren Schritt gebaut.)
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Niemals das Passwort selbst, immer nur dessen Hash.
  /// Verfahren: scrypt aus Node (siehe lib/passwort.ts).
  passwortHash String
  erstelltAm   DateTime  @default(now())
  letzterLogin DateTime?

  /// Das TOTP-Geheimnis (Base32), erst gesetzt, sobald die Einrichtung
  /// mit einem gültigen Code bestätigt wurde. Vorher steht hier nichts
  /// — ein begonnener, aber nie bestätigter Versuch soll nicht dazu
  /// führen, dass sich jemand aus dem eigenen Konto aussperrt.
  zweiterFaktorGeheimnis String?
  /// Erst NACH der Bestätigung "an". Erst dieser Schalter verlangt den
  /// zweiten Faktor beim Anmelden — nicht schon das blosse Vorhandensein
  /// eines Geheimnisses.
  zweiterFaktorAktiv     Boolean @default(false)

  sitzungen               AdminSession[]
  zweiterFaktorCodes      AdminZweiterFaktorCode[]
  zweiterFaktorPruefungen AdminZweiterFaktorPruefung[]
}

/// Eine angemeldete Sitzung im Adminbereich.
///
/// Bewusst in der Datenbank und nicht nur als signiertes Cookie: So
/// lässt sich eine Sitzung wirklich beenden. Ein signiertes Cookie
/// gilt bis zum Ablaufdatum weiter, auch wenn das Passwort längst
/// geändert wurde — bei einem Bereich mit Teilnehmerdaten ist das
/// zu wenig.
///
/// Gespeichert wird nur der HASH des Sitzungsschlüssels, nie der
/// Schlüssel selbst. Aus derselben Überlegung wie bei Passwörtern:
/// Wer die Datenbank in die Hände bekommt, kann sich damit nicht
/// anmelden.
model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  erstelltAm DateTime  @default(now())
  laeuftAbAm DateTime

  @@index([adminId])
  @@index([laeuftAbAm])
}

/// Ein Backup-Code für den zweiten Faktor — der Notausgang, wenn das
/// Gerät mit der Authenticator-App nicht zur Hand ist.
///
/// Wie beim Passwort steht hier NIE der Code selbst, nur sein Hash
/// (dasselbe Verfahren, lib/passwort.ts). Ein benutzter Code bleibt
/// als Zeile stehen (benutztAm gesetzt) statt gelöscht zu werden — so
/// lässt sich ein zweiter Versuch mit demselben Code ohne zusätzliche
/// Abfrage abweisen.
model AdminZweiterFaktorCode {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash   String
  erstelltAm DateTime  @default(now())
  benutztAm  DateTime?

  @@index([adminId])
}

/// Der Zwischenschritt "Passwort stimmt, der Code fehlt noch".
///
/// Ein eigener, kurzlebiger Zustand statt eines Feldes an der
/// eigentlichen Sitzung: Die richtige Sitzung (AdminSession) darf es
/// erst NACH dem zweiten Faktor geben. Sonst wäre ein Cookie schon vor
/// der vollständigen Anmeldung etwas wert.
///
/// Wie bei AdminSession steht im Cookie nur ein Zufallsschlüssel, hier
/// nur dessen Hash.
model AdminZweiterFaktorPruefung {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  erstelltAm DateTime  @default(now())
  laeuftAbAm DateTime

  @@index([adminId])
  @@index([laeuftAbAm])
}

/// Seitenweite Angaben — genau EINE Zeile mit der festen Kennung
/// "global".
///
/// Warum eine eigene Tabelle und nicht das Wörterbuch in content/de.ts:
/// Diese Angaben soll der Betreiber selbst ändern können, ohne den
/// Code anzufassen - genauso wie bei den Veranstaltungen.
///
/// Warum eine feste Kennung statt einer laufenden Nummer: So kann es
/// keine zweite Zeile geben, und es braucht keinen Seed-Schritt. Wer
/// liest, nimmt immer dieselbe; wer schreibt, legt sie beim ersten Mal
/// an (upsert).
model Einstellungen {
  id String @id @default("global")

  // Der Gründerbereich. Steht auf der zentralen VERA-Seite und — je
  // Event einschaltbar — auf einzelnen Eventseiten.
  gruenderName     String  @default("Adam Lasarzik")
  gruenderRolle    String  @default("Gründer von VERA")
  /// Leer bedeutet: es erscheint ein sichtbar markierter Platzhalter.
  /// Besser ein erkennbarer Platzhalter als ein erfundener Lebenslauf.
  gruenderText     String? @db.Text
  /// Adresse des hochgeladenen Fotos, z. B. /bilder/ab12....webp.
  /// Liegt AUSSERHALB von public/ — siehe lib/bilder.ts.
  gruenderBildUrl  String?
  /// Auf der zentralen VERA-Seite standardmäßig sichtbar.
  gruenderAufStart Boolean @default(true)

  geaendertAm DateTime @updatedAt
}

/// Jede Rückmeldung des Zahlungsanbieters genau EINMAL verarbeiten.
///
/// Stripe schickt eine Meldung notfalls mehrfach — das ist Absicht und
/// die richtige Vorgehensweise, denn sonst ginge eine Meldung bei einer
/// Störung verloren. Ohne diese Tabelle würde eine doppelt empfangene
/// Meldung aber auch doppelt wirken.
///
/// Bewusst getrennt von den Anmelde- und Zahlungsdaten und bewusst in
/// der Datenbank statt im Arbeitsspeicher: Ein Neustart darf nicht dazu
/// führen, dass eine bereits verarbeitete Meldung wieder als neu gilt.
model ZahlungsEreignis {
  /// Die Kennung, die der Zahlungsanbieter vergibt.
  id          String   @id
  art         String
  empfangenAm DateTime @default(now())
}

/// Eine Zahlung, die eingegangen ist, aber zu keiner Anmeldung führen konnte.
///
/// Ab dem Umbau vom 25.09.2026 entsteht eine Anmeldung erst mit der
/// bestätigten Zahlung. Zwischen dem Absenden des Formulars und dem
/// Zahlungseingang wird kein Platz mehr freigehalten — es kann also
/// passieren, dass in der Zwischenzeit jemand anders den letzten Platz
/// bezahlt hat. Dann gilt: Das Geld ist da, ein Vertrag kommt nicht
/// zustande, der Betrag geht vollständig zurück.
///
/// Diese Tabelle ist der Beleg dafür. Sie ist Pflicht, nicht Komfort:
/// Ein eingegangener und zurückgezahlter Betrag ist ein Geschäftsvorfall
/// und unterliegt § 147 AO. Sie gehört deshalb in die steuerrelevante
/// Klasse des Löschkonzepts und wird von der automatischen Löschung
/// ausdrücklich NICHT erfasst.
///
/// Bewusst OHNE Personenbezug: kein Name, keine E-Mail, keine
/// Teilnehmer. Wer nachforschen muss, findet die zahlende Person beim
/// Zahlungsanbieter unter derselben `sitzungId`. Sie hier ein zweites
/// Mal zu speichern, wäre eine Sammlung ohne Zweck.
///
/// **Nur bei echtem Geldeingang.** Ein Abbruch, eine abgelaufene
/// Bezahlseite oder eine fehlgeschlagene Karte hinterlassen KEINE
/// Zeile — dort ist kein Geld geflossen, und es gibt nichts zu belegen.
model Fehlbuchung {
  id String @id @default(cuid())

  /// Die Bezahlseite („cs_…") — die einzige Klammer zum Zahlungsanbieter.
  /// Eindeutig, damit eine doppelt zugestellte Rückmeldung nicht zu
  /// zwei Erstattungen führt.
  sitzungId   String @unique
  betragCents Int

  /// Warum keine Anmeldung entstehen konnte. Die vier Fälle sind am
  /// 25.09.2026 festgelegt worden:
  ///   keine-plaetze      der Platz war bei Zahlungseingang vergeben
  ///   doppelte-adresse   für diese Adresse gibt es schon eine Buchung
  ///   kein-termin        der Termin wurde inzwischen entfernt
  ///   betrag-abweichend  der gemeldete Betrag passt nicht
  grund String

  angelegtAm DateTime @default(now())

  /// Wann erstattet wurde. Leer heisst: noch offen.
  ///
  /// Bei vier der fünf Gründe wird sofort und vollständig erstattet;
  /// bleibt das Feld dort leer, ist die Erstattung steckengeblieben und
  /// der Abgleichlauf holt sie nach.
  ///
  /// Bei `betrag-abweichend` bleibt es ABSICHTLICH leer: Ein
  /// abweichender Betrag ist entweder ein Fehler oder ein Angriff, und
  /// beides gehört angesehen statt stillschweigend zurückgebucht. Der
  /// Adminbereich weist solche Zeilen als Warnung aus.
  erstattetAm  DateTime?
  /// Die Kennung der Erstattung beim Anbieter („re_…").
  erstattungId String?

  /// Wann jemand diesen Vorgang von Hand als geklärt abgehakt hat.
  ///
  /// Nachgetragen am 26.09.2026. Ohne dieses Feld hätte eine Zeile mit
  /// `betrag-abweichend` keinen Weg, jemals wieder aus der Warnung zu
  /// verschwinden: Dort wird absichtlich nicht automatisch erstattet,
  /// und `erstattetAm` bliebe für immer leer. Eine Warnung, die immer
  /// dasteht, wird nach zwei Wochen nicht mehr gelesen — und ist dann
  /// schlimmer als keine.
  ///
  /// Abhaken LÖSCHT NICHTS. Die Zeile bleibt mit Betrag, Grund und
  /// Sitzungskennung vollständig stehen; sie wird nur nicht mehr
  /// angemahnt.
  erledigtAm  DateTime?
  /// Wer abgehakt hat — die Kennung des Admin-Zugangs, kein Name.
  erledigtVon String?
  /// Ein kurzer Vermerk, warum der Vorgang erledigt ist.
  erledigtNotiz String? @db.Text

  @@index([erstattetAm])
  @@index([erledigtAm])
}

/// Wer hat wann was im Adminbereich getan.
///
/// Zweck: Ein Zugriff auf Teilnehmerdaten — ansehen, ändern, löschen,
/// exportieren — soll nachvollziehbar sein. Ohne das lässt sich nach
/// einem Vorfall nicht sagen, was passiert ist; einmal mussten wir
/// dafür bereits eine verschlüsselte Sicherung entschlüsseln.
///
/// Bewusst OHNE Personendaten der Teilnehmer: Es stehen nur Kennungen
/// darin, keine Namen, keine E-Mail-Adressen, keine Telefonnummern.
/// Ein Protokoll, das selbst zur Datensammlung wird, verschlimmert
/// genau das Problem, das es lösen soll.
///
/// Bewusst OHNE Fremdschlüssel auf AdminUser: Wird ein Zugang
/// entfernt, soll sein Protokoll bestehen bleiben. Ein Protokoll, das
/// sich mit dem Handelnden zusammen löschen lässt, ist keines.
model AdminProtokoll {
  id        String   @id @default(cuid())
  zeitpunkt DateTime @default(now())

  /// Wer gehandelt hat — nur die Kennung. Die E-Mail-Adresse steht
  /// bereits in AdminUser und wird hier nicht noch einmal abgelegt.
  adminId String

  /// Was getan wurde, z. B. "anmeldung.status" oder "csv.export".
  aktion String

  /// Woran: Art und Kennung des betroffenen Datensatzes.
  zielArt String?
  zielId  String?

  /// Kurzer, personenfreier Zusatz — etwa der neue Status oder eine
  /// Anzahl. Niemals ein Name und niemals eine Adresse.
  detail String?

  @@index([zeitpunkt])
  @@index([adminId, zeitpunkt])
}

// ── Missbrauchsschutz ────────────────────────────────────────────

/// Zählt Anmeldeversuche, um Massen-Einsendungen zu bremsen.
///
/// Bewusst in der Datenbank statt im Arbeitsspeicher: Ein Zähler im
/// Speicher vergisst bei jedem Neustart der Anwendung alles — und
/// genau darauf würde ein Angreifer warten. Kein externer Dienst
/// nötig, die vorhandene Datenbank genügt.
///
/// Streng von den Event- und Teilnehmerdaten getrennt: Hier stehen
/// keine Namen, nur eine Kennung (IP-Adresse) und ein Zeitpunkt.
/// Alte Einträge werden beim Prüfen mit aufgeräumt.
model AnmeldeVersuch {
  id        String   @id @default(cuid())
  kennung   String
  zeitpunkt DateTime @default(now())

  @@index([kennung, zeitpunkt])
}

/**
 * =================================================================
 * LÖSCHKONZEPT
 * Umsetzung von docs/rechtstexte-entwuerfe/13-loeschkonzept.md.
 * Grundgedanke: Jeder Datensatz trägt seine Löschklasse und sein
 * Fälligkeitsdatum selbst. Der nächtliche Lauf muss dadurch keine
 * Regeln raten — er liest, was am Datensatz steht, prüft die Sperre
 * und handelt.
 * Die Klasse STEUERUNTERLAGEN ist bewusst Teil der Aufzählung, wird
 * vom Löschlauf aber NIEMALS angefasst. Sie existiert, damit sich
 * steuerrelevante Datensätze ausdrücklich kennzeichnen lassen — und
 * damit ein späterer Lauf sie erkennbar überspringt, statt sie
 * mangels Kennzeichnung zu übersehen.
 * =================================================================
 */

enum Loeschklasse {
  /// K1 — Gesundheits- und Notfallangaben. 7 Tage nach Veranstaltungsende.
  GESUNDHEITSANGABEN
  /// K2 — vollständige Einverständniserklärungen. 3 Jahre ab Jahresende.
  EINVERSTAENDNIS_VOLL
  /// K3 — reduzierter Zustimmungsnachweis. 10 Jahre ab Jahresende.
  ZUSTIMMUNGSNACHWEIS
  /// K4 — Anmelde- und Check-in-Daten. 3 Jahre ab Jahresende.
  ANMELDEDATEN
  /// K5 — Veranstaltungs- und Sicherheitscheckliste. 3 Jahre, dann Personenbezug entfernen.
  CHECKLISTE
  /// K6 — Vorfall- und Versicherungsakte. Nach Abschluss je nach Einstufung.
  VORFALLAKTE
  /// K7 — steuerrelevant. Wird vom Löschlauf NIEMALS angefasst.
  STEUERUNTERLAGEN

  /// K8 — erklärter Widerspruch gegen Aufnahmen samt Prüfvermerk.
  /// EREIGNISBEZOGENE Frist (Entscheidung vom 21.09.2026, löst die
  /// frühere Fassung "niemals" ab):
  ///
  /// Solange `Event.aufnahmenOfflineAm` nicht gesetzt ist, gibt es
  /// kein Fälligkeitsdatum — der Löschlauf lässt den Datensatz in
  /// Ruhe (entscheide() in lib/loeschfristen.ts: kein faelligAm, also
  /// nie fällig). Begründung: Der Widerspruch ist der einzige
  /// Nachweis, dass eine Person nicht abgebildet werden möchte.
  /// Gelöscht, während Aufnahmen noch online stehen, liefe die
  /// Prüfung vor jeder Veröffentlichung ins Leere.
  ///
  /// Erst wenn ein Admin von Hand festhält, dass ALLE Aufnahmen
  /// dieser Veranstaltung endgültig offline sind (mit Datum,
  /// Bearbeiter und Prüfvermerk — nie automatisch durch den
  /// jährlichen Prüflauf allein), beginnt eine Nachlauffrist von drei
  /// Jahren zur Beweissicherung: faelligAufnahmewiderspruch() in
  /// lib/loeschfristen.ts, Fristende zum Jahresende des dritten
  /// Kalenderjahres danach. Ein zu diesem Zeitpunkt bestehender
  /// Streit, eine Beschwerde oder ein laufendes Verfahren sperrt die
  /// Löschung wie bei jeder anderen Klasse über eine Loeschsperre.
  AUFNAHMEWIDERSPRUCH
}

enum Sperrgrund {
  UNFALL
  BESCHWERDE
  RUECKBUCHUNG
  VERSICHERUNG
  RECHTSSTREIT
}

/// Einstufung eines Vorfalls — bestimmt die Aufbewahrungsdauer nach Abschluss.
enum VorfallEinstufung {
  /// Regelfall: 10 Jahre nach Abschluss.
  LEICHT
  /// Personen- oder Gesundheitsschaden: bis 30 Jahre (§ 199 Abs. 2 BGB).
  SCHWER
}

enum VorfallStatus {
  OFFEN
  ABGESCHLOSSEN
}

/// Setzt die automatische Löschung für EINZELNE Datensätze aus.
///
/// Ohne diese Tabelle darf kein Löschlauf scharf geschaltet werden:
/// Sonst vernichtet er genau die Unterlagen, die im Streitfall
/// gebraucht werden.
model Loeschsperre {
  id String @id @default(cuid())

  /// "Registration" | "Vorfall" | "Checkliste" | "Zustimmungsnachweis"
  zielArt String
  zielId  String

  grund Sperrgrund

  /// true = vom System gesetzt (z. B. bei Erstattung), false = von Hand.
  automatisch Boolean @default(false)

  gesetztAm  DateTime @default(now())
  /// AdminUser-Kennung oder "system".
  gesetztVon String
  notiz      String?  @db.Text

  aufgehobenAm  DateTime?
  aufgehobenVon String?

  @@index([zielArt, zielId, aufgehobenAm])
}

/// Vorfall-, Beschwerde- und Versicherungsakte.
///
/// Solange `status` OFFEN ist, wird nichts gelöscht — weder die Akte
/// noch die von ihr gesperrten Datensätze.
model Vorfall {
  id String @id @default(cuid())

  eventId        String?
  registrationId String?

  titel        String
  beschreibung String? @db.Text

  /// Im Adminbereich sichtbar und von Hand änderbar.
  einstufung VorfallEinstufung @default(LEICHT)
  status     VorfallStatus     @default(OFFEN)

  eroeffnetAm     DateTime  @default(now())
  abgeschlossenAm DateTime?

  /// Wird beim Abschluss berechnet: 10 Jahre (LEICHT) bzw. 30 (SCHWER).
  faelligAm    DateTime?
  loeschklasse Loeschklasse @default(VORFALLAKTE)

  erstelltVon String

  @@index([status, faelligAm])
}

/// Der reduzierte Zustimmungsnachweis (Stufe 2 des Stufenplans).
///
/// Entsteht, wenn die vollständige Einverständniserklärung nach drei
/// Jahren vernichtet wird. Enthält bewusst KEIN Geburtsdatum, KEINE
/// Mobilnummer und KEINE Gesundheitsangaben.
///
/// `selbstVerlassenGestattet` ist am 22.09.2026 entfallen: Es hielt
/// fest, ob die erziehungsberechtigte Person das selbstständige
/// Verlassen erlaubt hatte. Seit Adams Entscheidung dürfen ALLE
/// minderjährigen Teilnehmenden jederzeit selbstständig gehen — es
/// gibt also nichts mehr zu unterscheiden, und ein Feld, das eine
/// Erlaubnis dokumentiert, die niemand mehr erteilen muss, wäre ein
/// Widerspruch zum Rechtstext. Echte Daten gab es noch nicht.
model Zustimmungsnachweis {
  id String @id @default(cuid())

  eventId          String
  veranstaltungAm  DateTime
  /// Name der minderjährigen Person — der einzige Personenbezug.
  teilnehmerName   String
  zustimmungLagVor Boolean  @default(true)

  angelegtAm   DateTime     @default(now())
  faelligAm    DateTime
  loeschklasse Loeschklasse @default(ZUSTIMMUNGSNACHWEIS)

  @@index([faelligAm])
}

/// Veranstaltungs- und Sicherheitscheckliste.
///
/// Enthält mit `einweisungKuerzel` ein personenbezogenes Datum von
/// Beschäftigten. Nach drei Jahren wird dieses Feld unwiderruflich
/// geleert; nur die dann wirklich anonyme Sicherheitsdokumentation
/// bleibt erhalten.
model Checkliste {
  id String @id @default(cuid())

  eventId         String
  durchgefuehrtAm DateTime

  /// PERSONENBEZUG. Wird beim Anonymisieren auf null gesetzt.
  einweisungKuerzel String?
  /// Freitext zum Ablauf. Kann Personenbezug enthalten, wird mit geleert.
  notiz             String? @db.Text

  /// Anonyme Sicherheitsdokumentation — bleibt dauerhaft erhalten.
  einweisungErfolgt Boolean @default(false)
  teilnehmerAnzahl  Int?

  anonymisiertAm DateTime?
  faelligAm      DateTime
  loeschklasse   Loeschklasse @default(CHECKLISTE)

  @@index([faelligAm, anonymisiertAm])
}

/// Protokoll jedes Löschlaufs — ohne unnötige personenbezogene Inhalte.
///
/// Festgehalten werden Kennungen, niemals Namen, E-Mail-Adressen oder
/// Telefonnummern. Ein Protokoll, das die Daten enthält, die es zu
/// löschen half, wäre die Löschung rückgängig machende Kopie.
model Loeschprotokoll {
  id        String   @id @default(cuid())
  zeitpunkt DateTime @default(now())

  /// Gruppiert alle Einträge eines Laufs.
  laufId String

  klasse  Loeschklasse
  zielArt String
  /// Kennung des Datensatzes. KEIN Name, KEINE E-Mail.
  zielId  String

  /// "anonymisiert" | "geloescht" | "uebersprungen" | "faellig"
  aktion String
  /// Bei "uebersprungen": der Sperrgrund. Sonst leer.
  grund  String?

  /// true = Trockenlauf, es wurde nichts verändert.
  probelauf Boolean @default(false)

  @@index([laufId])
  @@index([zeitpunkt])
}

/// Welche Rechtstexte es gibt. Die Kennung ist stabil, die Fassungen
/// wechseln.
enum Rechtstextart {
  /// Teilnahmebedingungen für Verbraucher.
  AGB_B2C
  /// Bedingungen für Geschäftskunden.
  AGB_B2B
  /// Datenschutzerklärung.
  DATENSCHUTZ
}

/**
 * Eine unveränderbare Fassung eines Rechtstexts.
 * ── Unveränderbar heisst: nur einfügen, nie ändern ────────────────
 * Eine neue Fassung ist ein NEUER Datensatz, kein überschriebener.
 * Eine Datenbank kann das nicht von sich aus erzwingen — die Regel
 * steht deshalb in lib/rechtstexte.ts und wird von Prüfliste U
 * bewacht. Ohne diese Prüfung wäre „unveränderbar" eine
 * Absichtserklärung und keine Eigenschaft.
 * `pruefsumme` ist der SHA-256 über den Wortlaut. Sie belegt nicht
 * gegenüber Dritten, dass nichts geändert wurde — wer die Zeile
 * ändern kann, kann auch die Prüfsumme neu setzen. Sie macht eine
 * unbeabsichtigte Änderung aber sofort sichtbar, und genau dafür ist
 * sie da.
 */
model Rechtstext {
  id      String        @id @default(cuid())
  art     Rechtstextart
  /// Fortlaufend je Art, beginnend bei 1.
  version Int
  /// Das Stand-Datum, das im Text selbst genannt wird.
  datum   DateTime

  /// Ab wann diese Fassung für neue Vertragsschlüsse gilt. Massgeblich
  /// ist beim Speichern einer Buchung die neueste Fassung, deren
  /// `gueltigAb` nicht in der Zukunft liegt — nicht schlicht die
  /// neueste.
  gueltigAb DateTime

  /// Der vollständige Wortlaut.
  inhalt     String @db.Text
  /// SHA-256 über `inhalt`, hexadezimal.
  pruefsumme String

  erstelltAm DateTime @default(now())

  anmeldungenAgb         Registration[] @relation("AgbFassung")
  anmeldungenDatenschutz Registration[] @relation("DatenschutzFassung")

  @@unique([art, version])
  @@index([art, gueltigAb])
}

/// Auf welchem Weg der Widerspruch erklärt wurde.
enum Widerspruchsweg {
  /// Beim Ankommen, im Rahmen des Check-ins.
  CHECKIN
  /// Während der Veranstaltung, mündlich vor Ort.
  VOR_ORT
  /// Schriftlich, per E-Mail.
  EMAIL
  /// Auf einem anderen Weg — dann steht der Weg in der Notiz.
  SONSTIGES
}

/**
 * Ein erklärter Widerspruch gegen Foto-, Video- und Tonaufnahmen
 * (Art. 21 DS-GVO).
 * ── Warum es diese Tabelle gibt ───────────────────────────────────
 * Seit Entscheidung 4.8 gibt es KEINE Foto-Einwilligung mehr. Die
 * Aufnahmen stützen sich auf Art. 6 Abs. 1 Buchst. f DS-GVO, und wer
 * nicht abgebildet werden möchte, widerspricht. Damit ist der
 * Widerspruch die **einzige** technische Sicherung des gesamten
 * Konzepts: Fällt die Prüfung vor der Veröffentlichung aus, gibt es
 * keine zweite, weil keine Einwilligung danebensteht.
 * ── Warum nur die Ausnahme gespeichert wird ───────────────────────
 * Früher war geplant, je Person einen Einwilligungsstatus zu führen.
 * Jetzt steht hier nur, wer widersprochen hat — also die Ausnahme
 * statt der Regel. Das ist ein echter Gewinn nach Art. 5 Abs. 1
 * Buchst. c DS-GVO: Bei hundert Teilnehmenden und zwei Widersprüchen
 * werden zwei Namen gespeichert, nicht hundert.
 * ── Warum der Name genügt ─────────────────────────────────────────
 * Gespeichert wird der Name und, wenn bekannt, die Buchung. Mehr
 * braucht die Prüfung nicht: Sie fragt „ist diese Person auf der
 * Aufnahme erkennbar?", und dafür muss man wissen, wer gemeint ist.
 * Eine Adresse oder ein Geburtsdatum trüge dazu nichts bei.
 */
model Aufnahmewiderspruch {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Der Name der Person, wie sie ihn genannt hat.
  name String

  /// Die zugehörige Buchung, falls bekannt. Optional, weil ein
  /// Widerspruch auch von einer Begleitperson kommen kann, die selbst
  /// nicht gebucht hat.
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  weg        Widerspruchsweg @default(VOR_ORT)
  /// Freitext — etwa „nur Tochter, nicht der Vater" oder der genaue Weg.
  notiz      String?         @db.Text
  erklaertAm DateTime        @default(now())

  /// Wer ihn aufgenommen hat — für die Nachvollziehbarkeit.
  erfasstVon String

  /// Ein Widerspruch kann zurückgenommen werden. Dann bleibt die
  /// Zeile stehen: Sie belegt, dass zwischen Erklärung und Rücknahme
  /// ein Widerspruch bestand, und genau das kann später zählen.
  zurueckgenommenAm DateTime?

  loeschklasse Loeschklasse @default(AUFNAHMEWIDERSPRUCH)
  faelligAm    DateTime?

  @@index([eventId, zurueckgenommenAm])
}

/**
 * Der festgehaltene Abgleich vor einer Veröffentlichung oder vor der
 * Weitergabe an die Veranstaltungsstätte (Bauauftrag B-13).
 * Entscheidung 4.8 verlangt, dass **vor jeder Veröffentlichung und
 * vor jeder Weitergabe** geprüft wird, ob widersprechende Personen
 * erkennbar sind. Eine Prüfung, die nirgends festgehalten wird, ist
 * gegenüber einer Aufsichtsbehörde keine — deshalb diese Tabelle.
 * `widersprueche` hält fest, wie viele Widersprüche zum Zeitpunkt der
 * Prüfung vorlagen, und `namen` ihre Namen. Beides wird bewusst
 * KOPIERT statt nur verknüpft: Die Prüfung soll belegen, was damals
 * bekannt war. Kommt später ein Widerspruch hinzu, war er zum
 * Zeitpunkt dieser Prüfung eben noch nicht da — und das soll man
 * hinterher sehen können.
 */
model Veroeffentlichungspruefung {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Wohin veröffentlicht wurde, in Worten: „Website", „Instagram
  /// VERA", „Weitergabe an die Halle".
  ziel String

  /// Wie viele Widersprüche lagen zum Zeitpunkt der Prüfung vor.
  widersprueche Int
  /// Ihre Namen, als Klartext festgehalten.
  namen         String? @db.Text

  /// Das Ergebnis: Ist jemand erkennbar, der widersprochen hat?
  /// false = geprüft und niemand erkennbar, veröffentlicht.
  /// true  = erkennbar, deshalb nicht veröffentlicht oder bearbeitet.
  erkennbar Boolean @default(false)
  notiz     String? @db.Text

  geprueftAm  DateTime @default(now())
  geprueftVon String

  loeschklasse Loeschklasse @default(AUFNAHMEWIDERSPRUCH)
  faelligAm    DateTime?

  veroeffentlichungen Veroeffentlichung[]

  @@index([eventId, geprueftAm])
}

/// Wer für eine konkrete Veröffentlichung verantwortlich ist.
///
/// Nur diese zwei Rollen — genau die Beteiligten aus dem bereits
/// geprüften Konzept (Entscheidung 4.3, Phasenmodell nach EuGH
/// *Fashion ID*): VERA und die Veranstaltungsstätte sind getrennte,
/// nacheinander tätige Verantwortliche. Ein Dritter (Presse, Sponsor,
/// Kooperationspartner) ist im Konzept ausdrücklich NICHT vorgesehen
/// (Entscheidung 4.5) und taucht deshalb hier auch nicht als Rolle auf
/// — eine Veröffentlichung an einen Dritten wäre ein Verstoß gegen das
/// Konzept, kein regulärer Fall, den man auswählt.
enum VeroeffentlichungVerantwortlich {
  VERA
  VERANSTALTUNGSSTAETTE
}

/**
 * Eine einzelne, tatsächliche Veröffentlichung — der fehlende Teil
 * von B-14 (Bauauftrag B-14, Teil a): K8 (oben) speichert den
 * NACHWEIS über Widerspruch und Prüfung, aber bis hierher gab es
 * nirgends im System einen Datensatz für die Aufnahme SELBST — wo sie
 * hängt, wer dafür verantwortlich ist, und ob sie noch online steht.
 * ── Warum kein eigenes Dateifeld ──
 * Die Aufnahme selbst liegt nicht in dieser Datenbank — sie liegt auf
 * der Website von VERA, auf der Website der Veranstaltungsstätte oder
 * auf einer Plattform wie Instagram oder TikTok. VERA kann sie von
 * hier aus nicht automatisch entfernen. Diese Zeile ist deshalb kein
 * Dateispeicher, sondern das PROTOKOLL: wo etwas veröffentlicht wurde
 * und — sobald ein Mensch es dort tatsächlich entfernt hat — wann.
 * ── Die Verbindung zu K8 ──
 * `entferntAm` ist NICHT dasselbe wie `Event.aufnahmenOfflineAm`.
 * Erst wenn für ein Event KEINE einzige Veroeffentlichung mehr offen
 * ist (jede `entferntAm` trägt), darf `Event.aufnahmenOfflineAm`
 * überhaupt gesetzt werden — das erzwingt `aufnahmenOfflineSetzen()`
 * in lib/aufnahmen.ts. Genau das setzt „solange Inhalte veröffentlicht
 * sind, bleiben die Widerspruchsnachweise gespeichert" technisch um,
 * statt es nur zu behaupten.
 * ── Warum diese Zeile selbst KEINE eigene Löschklasse hat ──
 * Sie enthält keine personenbezogenen Daten Teilnehmender — nur
 * organisatorische Fakten (Ort, Zweck, Verantwortlicher, Zeitpunkte).
 * Sie bleibt deshalb wie das Admin-Protokoll dauerhaft als
 * Rechenschaftsnachweis stehen (Art. 5 Abs. 2 DS-GVO) und wird vom
 * Löschlauf nicht angefasst — bewusste Entscheidung, kein Versehen.
 */
model Veroeffentlichung {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Wo veröffentlicht wurde, in Worten: „Website VERA", „Instagram
  /// VERA", „Website der Veranstaltungsstätte", „Instagram der
  /// Veranstaltungsstätte", „TikTok der Veranstaltungsstätte" — und
  /// so weiter, je nachdem, was die Veranstaltungsstätte tatsächlich
  /// betreibt.
  ort String

  verantwortlich VeroeffentlichungVerantwortlich

  /// Wofür, in Worten — z. B. „eigene Veranstaltungswerbung".
  zweck String

  /// Die Prüfung (B-13), die diese Veröffentlichung freigegeben hat,
  /// falls bekannt. Optional: eine Veröffentlichung lässt sich auch
  /// nachträglich dokumentieren, ohne dass sich der ursprüngliche
  /// Prüfvermerk mehr eindeutig zuordnen lässt.
  pruefungId String?
  pruefung   Veroeffentlichungspruefung? @relation(fields: [pruefungId], references: [id], onDelete: SetNull)

  veroeffentlichtAm DateTime @default(now())

  /// null = noch veröffentlicht. Erst ab hier zählt diese Zeile als
  /// „entfernt" im Sinne der K8-Regel.
  entferntAm      DateTime?
  entferntVon     String?
  entfernungNotiz String?   @db.Text

  erfasstVon String
  erfasstAm  DateTime @default(now())

  @@index([eventId, entferntAm])
}
