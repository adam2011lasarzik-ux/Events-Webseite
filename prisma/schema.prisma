// ─────────────────────────────────────────────────────────────────
//  VERA — Datenmodell
//
//  Drei Ebenen, wie im Skill event-backend-database festgelegt:
//
//    Event         die Veranstaltung
//    Registration  EINE Anmeldung (Buchung) einer anmeldenden Person
//    Participant   EINE teilnehmende Person, gehört zu einer Anmeldung
//
//  Der häufigste Denkfehler wäre, eine Anmeldung mit einer Person
//  gleichzusetzen. Eine Familienbuchung mit 2 Erwachsenen und 4
//  Schülern ist EINE Anmeldung mit SECHS Teilnehmern — und belegt
//  sechs Plätze, nicht einen.
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ── Veranstaltung ────────────────────────────────────────────────

enum EventKategorie {
  SPORT
  BUSINESS
  NETWORKING
  SCHULE
  COMMUNITY
  WORKSHOP
  FREIZEIT
  SONSTIGES
}

/// Redaktioneller Zustand — eine bewusste Entscheidung des Veranstalters.
/// NICHT zu verwechseln mit „läuft noch / ist vorbei": Ob ein Event in der
/// Zukunft liegt, gerade läuft oder vorbei ist, ergibt sich aus startAt und
/// endAt und wird deshalb berechnet, nicht gespeichert. Zwei Quellen für
/// dieselbe Wahrheit laufen sonst auseinander.
enum EventStatus {
  ENTWURF
  VEROEFFENTLICHT
  ARCHIVIERT
}

/// Das Aussehen der Event-Seite.
///
/// Nur die Darstellung ändert sich — Daten, Preise, Plätze und die
/// Anmeldung bleiben in jedem Theme identisch. Der Standardwert sorgt
/// dafür, dass bereits vorhandene Veranstaltungen ohne Zutun weiter
/// aussehen wie bisher.
///
/// Ein weiteres Theme braucht künftig genau drei Schritte: ein Wert
/// hier, ein Eintrag in lib/themes.ts, ein Block in styles/themes.css.
enum EventTheme {
  STANDARD
  BUSINESS
  PREMIUM
}

model Event {
  id     String @id @default(cuid())
  /// Teil der Adresse, z. B. /events/padel-falkensee
  slug   String @unique
  status EventStatus    @default(ENTWURF)
  kategorie EventKategorie @default(SONSTIGES)
  theme  EventTheme     @default(STANDARD)

  // Texte
  titel          String
  untertitel     String?
  /// Kurzfassung für die Karte auf der Startseite
  karteTitel     String
  karteKurz      String  @db.Text
  karteZielgruppe String?
  /// Kurztext auf der Event-Seite selbst (nicht zu verwechseln mit
  /// karteKurz, das auf der Startseiten-Karte steht)
  kurz           String  @db.Text
  beschreibung   String  @db.Text
  /// Freies Feld für alles, was nur dieses eine Event betrifft
  hinweise       String? @db.Text

  // Kopfbereich der Event-Seite. Stand früher im globalen Wörterbuch —
  // dort hätte jedes Event dieselbe Überschrift bekommen („Nie
  // gespielt?" über einem Unternehmer-Netzwerkabend). Leer bedeutet:
  // titel bzw. kurz werden verwendet, bestehende Events brechen also
  // nicht.
  heroAugenbraue String?
  heroTitel      String?
  heroText       String? @db.Text

  // Abschluss-Aufruf am Seitenende. Ebenfalls je Event: „Bereit für
  // den ersten Ballwechsel?" unter einem Unternehmer-Netzwerkabend
  // wäre unfreiwillig komisch. Leer = der neutrale Text aus dem
  // Wörterbuch.
  ctaTitel       String?
  ctaText        String? @db.Text

  // Zeit — null bedeutet „steht noch nicht fest" und wird auf der
  // Seite als sichtbarer Platzhalter angezeigt.
  startAt DateTime?
  endAt   DateTime?

  // Ort
  ortName String?
  strasse String?
  plz     String?
  stadt   String

  // Medien. Bewusst je Event: eine globale Variable würde jedem
  // zweiten Event dasselbe Video verpassen.
  bildUrl  String?
  videoUrl String?

  /// Zeigt diese Eventseite den Gründerbereich?
  ///
  /// Standardmäßig aus: Bestehende Veranstaltungen sehen damit
  /// unverändert aus, bis der Haken bewusst gesetzt wird. Foto, Name
  /// und Text selbst stehen NICHT hier, sondern einmalig in
  /// Einstellungen — sie gehören zu VERA, nicht zu einem Event.
  gruenderZeigen Boolean @default(false)

  // Plätze. maxPersonen zählt PERSONEN, nicht Anmeldungen.
  // null = unbegrenzt.
  maxPersonen        Int?
  /// Ab wie wenigen freien Plätzen die genaue Zahl angezeigt wird
  schwelleWenigPlaetze Int @default(10)

  // Preise, immer in ganzen Cent. Kommazahlen rechnen bei Geld
  // ungenau (0.1 + 0.2 ist nicht exakt 0.3).
  preisSchuelerCents    Int
  preisErwachsenerCents Int

  // Familienpaket
  familieAktiv              Boolean @default(false)
  familieBasisCents         Int?
  familieEnthaltenErwachsene Int?
  familieEnthaltenSchueler   Int?
  familieWeitererSchuelerCents Int?
  familieMaxSchueler         Int?

  // Anmeldezeitraum (optional)
  anmeldungAb  DateTime?
  anmeldungBis DateTime?

  erstelltAm   DateTime @default(now())
  geaendertAm  DateTime @updatedAt

  anmeldungen Registration[]
  abschnitte  EventAbschnitt[]

  @@index([status, startAt])
}

/// Optionale Inhaltsblöcke je Event — Programm, Speaker, Sponsoren,
/// Anfahrt und was künftige Event-Arten sonst brauchen.
///
/// Eigene Tabelle statt eines JSON-Feldes: So bleibt die Struktur
/// prüfbar und sortierbar, und ein Workshop kann andere Blöcke haben
/// als ein Sportevent, ohne dass die Event-Tabelle wächst.
/// (Angelegt, aber noch nicht auf der Webseite angezeigt.)
model EventAbschnitt {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// z. B. "programm", "speaker", "sponsoren", "anfahrt"
  art      String
  titel    String
  inhalt   String @db.Text
  reihenfolge Int  @default(0)

  @@index([eventId, reihenfolge])
}

// ── Anmeldung (Buchung) ──────────────────────────────────────────

enum Buchungsart {
  EINZEL
  FAMILIE
}

enum AnmeldeStatus {
  BESTAETIGT
  WARTELISTE
  STORNIERT
}

enum ZahlungsStatus {
  OFFEN
  BEZAHLT
  ERSTATTET
  TEILWEISE_ERSTATTET
}

enum ZahlungsWeg {
  VOR_ORT
  UEBERWEISUNG
  ONLINE
}

model Registration {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Anmeldende Person (nicht zwingend selbst Teilnehmer — ein
  // Elternteil kann nur das Kind anmelden und bleibt trotzdem
  // Vertragspartner).
  kontaktVorname  String
  kontaktNachname String
  kontaktEmail    String
  kontaktTelefon  String?

  buchungsart Buchungsart   @default(EINZEL)
  status      AnmeldeStatus @default(BESTAETIGT)

  // Minderjährige: Einwilligung der Erziehungsberechtigten ist
  // Pflicht, sobald Minderjährige dabei sind. Die Foto-Einwilligung
  // ist davon getrennt und freiwillig — eine Anmeldung darf nicht
  // daran scheitern, dass jemand keine Fotos möchte.
  istVormundBuchung   Boolean @default(false)
  einwilligungVormund Boolean @default(false)
  einwilligungFotos   Boolean @default(false)

  /// Zum Zeitpunkt der Anmeldung eingefroren. Ändert der Veranstalter
  /// später den Eventpreis, darf sich der Betrag einer bereits
  /// erfolgten Anmeldung nicht rückwirkend verändern.
  gesamtpreisCents Int

  // Zahlungsstatus wird GETRENNT vom Anmeldestatus geführt:
  // jemand kann angemeldet, aber noch nicht bezahlt haben.
  zahlungsStatus ZahlungsStatus @default(OFFEN)
  zahlungsWeg    ZahlungsWeg    @default(ONLINE)
  /// Referenz des Zahlungsanbieters, für den Abgleich
  zahlungsReferenz String?
  bezahlterBetragCents Int?
  bezahltAm      DateTime?

  angemeldetAm  DateTime  @default(now())
  reaktiviertAm DateTime?
  storniertAm   DateTime?

  /// Gesetzt, wenn die Personendaten auf Wunsch gelöscht wurden.
  /// Eine Stornierung ist KEINE Löschung: sie muss gespeichert
  /// bleiben, damit Platzzählung und Zahlungsabgleich stimmen. Für das
  /// echte Löschrecht werden Namen, E-Mail und Telefon überschrieben —
  /// die Anmeldung selbst bleibt als anonyme Zeile bestehen.
  anonymisiertAm DateTime?

  teilnehmer Participant[]

  /// Duplikatsschutz auf Anmeldungs-Ebene: pro Event und E-Mail-Adresse
  /// gibt es genau EINE Anmeldung — auch über Stornierungen hinweg.
  ///
  /// MySQL kennt keine Teil-Indizes wie PostgreSQL, man kann also nicht
  /// „nur aktive Anmeldungen müssen eindeutig sein" erzwingen. Deshalb
  /// der einfachere und robustere Weg: Meldet sich jemand nach einer
  /// Stornierung erneut an, wird derselbe Datensatz reaktiviert statt
  /// ein zweiter angelegt. Damit ist die Bedingung immer erfüllt und es
  /// bleiben keine verwaisten Doppel-Einträge zurück.
  @@unique([eventId, kontaktEmail])
  @@index([eventId, status])
}

// ── Teilnehmende Person ──────────────────────────────────────────

enum TeilnehmerTyp {
  SCHUELER
  ERWACHSENER
}

model Participant {
  id             String       @id @default(cuid())
  registrationId String
  anmeldung      Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  vorname  String
  nachname String
  typ      TeilnehmerTyp

  /// Nur das Jahr, nicht das volle Geburtsdatum — bei Minderjährigen
  /// so sparsam wie möglich mit Daten umgehen.
  geburtsjahr Int?

  @@index([registrationId])
}

// ── Verwaltung ───────────────────────────────────────────────────

/// Zugang zum geschützten Adminbereich. Als Tabelle angelegt statt als
/// Passwort in einer Umgebungsvariable, damit später ein zweiter
/// Administrator dazukommen kann, ohne das Modell zu ändern.
/// (Angelegt, die Anmeldung selbst wird in einem späteren Schritt gebaut.)
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Niemals das Passwort selbst, immer nur dessen Hash.
  /// Verfahren: scrypt aus Node (siehe lib/passwort.ts).
  passwortHash String
  erstelltAm   DateTime @default(now())
  letzterLogin DateTime?

  sitzungen AdminSession[]
}

/// Eine angemeldete Sitzung im Adminbereich.
///
/// Bewusst in der Datenbank und nicht nur als signiertes Cookie: So
/// lässt sich eine Sitzung wirklich beenden. Ein signiertes Cookie
/// gilt bis zum Ablaufdatum weiter, auch wenn das Passwort längst
/// geändert wurde — bei einem Bereich mit Teilnehmerdaten ist das
/// zu wenig.
///
/// Gespeichert wird nur der HASH des Sitzungsschlüssels, nie der
/// Schlüssel selbst. Aus derselben Überlegung wie bei Passwörtern:
/// Wer die Datenbank in die Hände bekommt, kann sich damit nicht
/// anmelden.
model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  erstelltAm DateTime  @default(now())
  laeuftAbAm DateTime

  @@index([adminId])
  @@index([laeuftAbAm])
}

/// Seitenweite Angaben — genau EINE Zeile mit der festen Kennung
/// "global".
///
/// Warum eine eigene Tabelle und nicht das Wörterbuch in content/de.ts:
/// Diese Angaben soll der Betreiber selbst ändern können, ohne den
/// Code anzufassen - genauso wie bei den Veranstaltungen.
///
/// Warum eine feste Kennung statt einer laufenden Nummer: So kann es
/// keine zweite Zeile geben, und es braucht keinen Seed-Schritt. Wer
/// liest, nimmt immer dieselbe; wer schreibt, legt sie beim ersten Mal
/// an (upsert).
model Einstellungen {
  id String @id @default("global")

  // Der Gründerbereich. Steht auf der zentralen VERA-Seite und — je
  // Event einschaltbar — auf einzelnen Eventseiten.
  gruenderName     String   @default("Adam Lasarzik")
  gruenderRolle    String   @default("Gründer von VERA")
  /// Leer bedeutet: es erscheint ein sichtbar markierter Platzhalter.
  /// Besser ein erkennbarer Platzhalter als ein erfundener Lebenslauf.
  gruenderText     String?  @db.Text
  /// Adresse des hochgeladenen Fotos, z. B. /bilder/ab12....webp.
  /// Liegt AUSSERHALB von public/ — siehe lib/bilder.ts.
  gruenderBildUrl  String?
  /// Auf der zentralen VERA-Seite standardmäßig sichtbar.
  gruenderAufStart Boolean  @default(true)

  geaendertAm DateTime @updatedAt
}

// ── Missbrauchsschutz ────────────────────────────────────────────

/// Zählt Anmeldeversuche, um Massen-Einsendungen zu bremsen.
///
/// Bewusst in der Datenbank statt im Arbeitsspeicher: Ein Zähler im
/// Speicher vergisst bei jedem Neustart der Anwendung alles — und
/// genau darauf würde ein Angreifer warten. Kein externer Dienst
/// nötig, die vorhandene Datenbank genügt.
///
/// Streng von den Event- und Teilnehmerdaten getrennt: Hier stehen
/// keine Namen, nur eine Kennung (IP-Adresse) und ein Zeitpunkt.
/// Alte Einträge werden beim Prüfen mit aufgeräumt.
model AnmeldeVersuch {
  id        String   @id @default(cuid())
  kennung   String
  zeitpunkt DateTime @default(now())

  @@index([kennung, zeitpunkt])
}
