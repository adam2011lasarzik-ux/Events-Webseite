# ─────────────────────────────────────────────────────────────────
#  Vorlage — hier stehen NUR Platzhalter, niemals echte Zugangsdaten.
#
#  Diese Datei gehört ins Repository und dokumentiert, welche Werte
#  das Projekt braucht. Die echten Werte stehen:
#    - in der Entwicklung  →  in .env  (von Git ausgeschlossen)
#    - im Livebetrieb      →  in den Umgebungsvariablen beim Hoster
# ─────────────────────────────────────────────────────────────────

# Verbindung zur Datenbank.
# Aufbau: mysql://BENUTZER:PASSWORT@SERVER:PORT/DATENBANKNAME
DATABASE_URL="mysql://benutzer:passwort@127.0.0.1:3306/datenbankname"

# Wo die im Adminbereich hochgeladenen Titelbilder liegen.
# Leer lassen = ./daten/bilder im Projektordner (gut für die Entwicklung).
# Beim Hoster auf ein Verzeichnis zeigen, das ein Deployment NICHT
# überschreibt — sonst sind alle Bilder nach dem nächsten Update weg.
# BILDER_VERZEICHNIS="/home/benutzer/vera-bilder"

# Die öffentliche Adresse dieser Seite — ohne Schrägstrich am Ende.
# Daraus werden die Rücksprungadressen der Bezahlseite gebaut.
# Bewusst eine eigene Variable und nicht aus der Anfrage abgeleitet:
# Der Host-Kopf einer Anfrage lässt sich fälschen.
OEFFENTLICHE_ADRESSE="http://localhost:3000"

# ── Zahlung (Stripe) ─────────────────────────────────────────────
#
# ZURZEIT AUSSCHLIESSLICH TESTBETRIEB. lib/zahlung.ts weist jeden
# Schlüssel ab, der nicht mit sk_test_ beginnt. Der Echtbetrieb ist
# damit keine vergessene Einstellung, sondern eine bewusste spätere
# Änderung.
#
# Zu finden im Stripe-Dashboard bei eingeschaltetem Testmodus unter
# „Entwickler → API-Schlüssel". Echte Schlüssel gehören niemals hierher
# und niemals nach GitHub.
ZAHLUNG_GEHEIMSCHLUESSEL="sk_test_hier_der_testschluessel"

# Das Geheimnis des Webhooks, ebenfalls aus dem Stripe-Dashboard
# („Entwickler → Webhooks"). Ohne diesen Wert wird KEINE Rückmeldung
# verarbeitet — eine Zahlung ohne gültige Unterschrift zu glauben wäre
# eine offene Tür.
ZAHLUNG_WEBHOOK_GEHEIMNIS="whsec_hier_das_webhook_geheimnis"

# Versand automatischer E-Mails über das Business-Postfach
# SMTP_SERVER=""
# SMTP_PORT="587"
# SMTP_BENUTZER=""
# SMTP_PASSWORT=""
# SMTP_ABSENDER=""
